# Copy to .env and fill in. Only values you want to override need to be present;
# every key below has a default in backend/app/config.py.

# --- required ---
GROQ_API_KEY=gsk_key_here
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this signs every existing session out.
JWT_SECRET_KEY=change-me-in-production

# --- auth ---
AUTH_COOKIE_SECURE=true   # set true when served over HTTPS
JWT_EXPIRY_MINUTES=10080
PASSWORD_MIN_LENGTH=10

# --- storage ---
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag
UPLOAD_DIR=/data/uploads
CHROMA_DIR=/data/chroma

# --- model / generation ---
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- retrieval tuning ---
TOP_K=6
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_BM25_WEIGHT=0.8
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

LOG_LEVEL=INFO
