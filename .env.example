# Copy to .env and fill in. Only values you want to override need to be present;
# every key below has a default in backend/app/config.py.

# --- required ---
GROQ_API_KEY=gsk_key_here

# No default exists in code — the API will not start until this is set, and
# refuses anything shorter than 32 characters. Changing it signs every existing
# session out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- auth ---
# true = the cookie is only sent over HTTPS. Correct for production, but on
# plain http://localhost the browser silently DISCARDS the cookie: login looks
# like it succeeds and you land straight back on the sign-in screen. Use false
# for local development.
AUTH_COOKIE_SECURE=true
JWT_EXPIRY_MINUTES=10080
PASSWORD_MIN_LENGTH=10

# --- abuse limits ---
# Number of proxies in front of the API. 1 for the bundled nginx. Set to 0 if
# the API is exposed directly, otherwise callers can spoof X-Forwarded-For and
# lift their own rate limit.
TRUSTED_PROXY_HOPS=1
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# --- per-user caps ---
MAX_DOCUMENTS_PER_USER=100
MAX_STORAGE_BYTES_PER_USER=524288000

# --- database ---
# These initialise Postgres and are also read by the API, which assembles the
# connection URL itself with proper escaping. The password is never formatted
# into a URL string, so any character is safe here.
# Note: '#' still ends the line in a .env file regardless, and compose treats
# '$' as interpolation — escape it as '$$'. Everything else is fine.
POSTGRES_USER=rag
POSTGRES_PASSWORD=generateALongPasswordHere
POSTGRES_DB=rag
# POSTGRES_HOST defaults to localhost; compose sets it to the service name.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Set this only if you have a ready-made URL, which is what managed platforms
# hand you. When present it wins over the POSTGRES_* parts above.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- storage ---
# Uploaded files. Embeddings and the lexical index live in Postgres, so this
# is the only directory that holds state outside the database.
UPLOAD_DIR=/data/uploads

# --- model / generation ---
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- retrieval tuning ---
TOP_K=6
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_BM25_WEIGHT=0.8
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- ingestion worker ---
# Ingestion runs in a separate process (docker compose service "worker").
# JOB_STALE_AFTER_SECONDS must stay comfortably larger than
# JOB_HEARTBEAT_INTERVAL_SECONDS, or the reaper will requeue documents that
# are still processing normally and two workers will race on the same file.
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=30
JOB_HEARTBEAT_INTERVAL_SECONDS=15
JOB_STALE_AFTER_SECONDS=300

# --- retrieval index tuning ---
# HNSW_EF_SEARCH must exceed VECTOR_CANDIDATE_COUNT or the index cannot return
# that many neighbours at all. Raising it trades latency for recall.
HNSW_EF_SEARCH=100
# Requires pgvector >= 0.8. Without it, a filtered vector search can return
# fewer rows than asked for — silently, and only for users whose documents are
# a small share of the corpus. The API logs a warning at first query if the
# server is too old.
HNSW_ITERATIVE_SCAN=relaxed_order

# --- logging ---
# json for anything that ships logs somewhere; console when you are reading a
# terminal. Both carry request_id and user_id on every record.
LOG_LEVEL=INFO
LOG_RENDERER=json
# Print the per-stage latency block (Database / Vector search / LLM / ...)
# after each request. Useful locally, noisy in aggregation — the same numbers
# are always on the structured record under "stages".
LOG_TIMING_BREAKDOWN=false
